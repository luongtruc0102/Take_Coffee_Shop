// Cấu hình Prisma Client để NestJS có thể thao tác với database
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"

  // NestJS hiện tại của project đang chạy theo CommonJS
  moduleFormat = "cjs"
}

// Project sử dụng PostgreSQL
datasource db {
  provider = "postgresql"
}

// Vai trò của người dùng trong hệ thống
// Ví dụ: ADMIN, STAFF, USER
model Role {
  id        Int      @id @default(autoincrement())
  name      String   @unique

  // Một Role có thể được gán cho nhiều User
  users     User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Tài khoản người dùng trong hệ thống
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique

  // Mật khẩu sẽ được hash trước khi lưu vào database
  password  String

  fullName  String?

  // Foreign Key liên kết User với Role
  roleId    Int
  role      Role     @relation(fields: [roleId], references: [id])

  // Trạng thái tài khoản: true = hoạt động, false = bị khóa
  isActive  Boolean  @default(true)

  // Mỗi user có tối đa một giỏ hàng
  cart      Cart?

  // Các đơn hàng mà user đã đặt
  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Danh mục sản phẩm
model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  isActive    Boolean   @default(true)

  // Một danh mục có nhiều sản phẩm
  products    Product[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Sản phẩm trong menu
model Product {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  price       Decimal   @db.Decimal(10, 2)
  imageUrl    String?
  isActive    Boolean   @default(true)

  // Mỗi sản phẩm thuộc một danh mục
  categoryId  Int
  category    Category  @relation(fields: [categoryId], references: [id])

  // Một sản phẩm có thể dùng nhiều topping
  toppings    ProductTopping[]

  // Một sản phẩm có thể có nhiều size / biến thể
  variants    ProductVariant[]

  // Các món trong giỏ hàng đang tham chiếu tới sản phẩm này
  cartItems   CartItem[]

  // Các OrderItem từng mua sản phẩm này
  orderItems OrderItem[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([categoryId])
}

// Biến thể sản phẩm theo size
model ProductVariant {
  id        Int      @id @default(autoincrement())

  // Ví dụ: S, M, L
  size      String

  // Giá riêng của từng size
  price     Decimal  @db.Decimal(10, 2)

  // Trạng thái variant: true = hoạt động, false = bị khóa
  isActive  Boolean  @default(true)

  // Mỗi variant thuộc về một sản phẩm
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Các CartItem đang sử dụng size này
  cartItems CartItem[]

  // Các OrderItem từng sử dụng variant này
  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Một sản phẩm không được có 2 variant cùng size
  @@unique([productId, size])

  // Tăng tốc truy vấn theo productId
  @@index([productId])
}

// Topping có thể thêm vào sản phẩm
model Topping {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  price       Decimal   @db.Decimal(10, 2)
  isActive    Boolean   @default(true)

  // Một topping có thể áp dụng cho nhiều sản phẩm
  products    ProductTopping[]

  // Các CartItem đang chọn topping này
  cartItems   CartItemTopping[]

  // Các topping đã được lưu trong lịch sử đơn hàng
  orderItems OrderItemTopping[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Bảng trung gian cho quan hệ nhiều-nhiều Product và Topping
model ProductTopping {
  productId Int
  toppingId Int

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  topping Topping @relation(fields: [toppingId], references: [id], onDelete: Cascade)

  // Một cặp Product + Topping chỉ được tồn tại một lần
  @@id([productId, toppingId])

  @@index([toppingId])
}

// Giỏ hàng của người dùng
model Cart {
  id     Int @id @default(autoincrement())

  // Mỗi user chỉ có một giỏ hàng
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Các món hiện có trong giỏ hàng
  items  CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Một món đã được thêm vào giỏ hàng
model CartItem {
  id Int @id @default(autoincrement())

  // CartItem thuộc về một giỏ hàng
  cartId Int
  cart   Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  // Sản phẩm được chọn
  productId Int
  product   Product @relation(fields: [productId], references: [id])

  // Size / variant được chọn
  variantId Int
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  // Số lượng sản phẩm
  quantity Int @default(1)

  // Các topping được chọn cho CartItem này
  toppings CartItemTopping[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cartId])
  @@index([productId])
  @@index([variantId])
}

// Bảng trung gian lưu topping được chọn cho từng CartItem
model CartItemTopping {
  cartItemId Int
  toppingId  Int

  cartItem CartItem @relation(fields: [cartItemId], references: [id], onDelete: Cascade)
  topping  Topping  @relation(fields: [toppingId], references: [id])

  // Một topping chỉ được chọn một lần trong cùng một CartItem
  @@id([cartItemId, toppingId])

  @@index([toppingId])
}

// Trạng thái xử lý đơn hàng
enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  DELIVERING
  COMPLETED
  CANCELLED
}

// Đơn hàng của người dùng
model Order {
  id Int @id @default(autoincrement())

  // User đã đặt đơn
  userId Int
  user   User @relation(fields: [userId], references: [id])

  // Tổng tiền được chốt tại thời điểm đặt hàng
  totalPrice Decimal @db.Decimal(10, 2)

  // Thông tin nhận hàng được lưu snapshot theo từng đơn
  receiverName    String
  receiverPhone   String
  deliveryAddress String
  note            String?

  status OrderStatus @default(PENDING)

  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

// Một sản phẩm trong đơn hàng
model OrderItem {
  id Int @id @default(autoincrement())

  orderId Int
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Giữ relation để tra cứu sản phẩm gốc
  productId Int
  product   Product @relation(fields: [productId], references: [id])

  variantId Int
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  // Snapshot thông tin tại thời điểm đặt hàng
  productName String
  size        String

  // Giá variant tại thời điểm checkout
  variantPrice Decimal @db.Decimal(10, 2)

  quantity Int

  // Giá 1 món = variant + toàn bộ topping
  unitPrice Decimal @db.Decimal(10, 2)

  // Tổng tiền của dòng = unitPrice × quantity
  lineTotal Decimal @db.Decimal(10, 2)

  toppings OrderItemTopping[]

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

// Snapshot topping trong từng OrderItem
model OrderItemTopping {
  id Int @id @default(autoincrement())

  orderItemId Int
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  // Giữ toppingId để truy vết dữ liệu gốc
  toppingId Int
  topping   Topping @relation(fields: [toppingId], references: [id])

  // Snapshot tên và giá topping tại thời điểm đặt
  toppingName  String
  toppingPrice Decimal @db.Decimal(10, 2)

  @@index([orderItemId])
  @@index([toppingId])
}