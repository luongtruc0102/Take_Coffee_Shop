// Cấu hình Prisma Client để NestJS có thể thao tác với database
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"

  // NestJS hiện tại của project đang chạy theo CommonJS
  moduleFormat = "cjs"
}

// Project sử dụng PostgreSQL
datasource db {
  provider = "postgresql"
}

// Vai trò của người dùng trong hệ thống
// Ví dụ: ADMIN, STAFF, USER
model Role {
  id   Int    @id @default(autoincrement())
  name String @unique

  // Một Role có thể được gán cho nhiều User
  users User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Tài khoản người dùng trong hệ thống
model User {
  id    Int    @id @default(autoincrement())
  email String @unique

  // Mật khẩu sẽ được hash trước khi lưu vào database
  password String

  fullName  String?
  phone     String? @unique
  avatarUrl String?
  address   String?

  // Foreign Key liên kết User với Role
  roleId Int
  role   Role @relation(fields: [roleId], references: [id])

  // Trạng thái tài khoản: true = hoạt động, false = bị khóa
  isActive Boolean @default(true)

  // Điểm khách hàng tích lũy từ các đơn hoàn tất
  loyaltyPoints Int @default(0)

  // Mỗi user có tối đa một giỏ hàng
  cart Cart?

  // Các đơn hàng mà user đã đặt
  orders Order[]

  // Danh sách địa chỉ giao hàng đã lưu của khách.
  addresses UserAddress[]

  // Các đánh giá do khách tạo
  orderReviews OrderReview[] @relation("ReviewAuthor")

  // Các đánh giá mà Admin đã phản hồi
  reviewReplies OrderReview[] @relation("ReviewResponder")

  // Thông báo bền vững để user xem lại trên mọi thiết bị
  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Danh mục sản phẩm
model Category {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?
  isActive    Boolean @default(true)

  // Một danh mục có nhiều sản phẩm
  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Sản phẩm trong menu
model Product {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  price       Decimal @db.Decimal(10, 2)
  imageUrl    String?
  isActive    Boolean @default(true)

  // Mỗi sản phẩm thuộc một danh mục
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])

  // Một sản phẩm có thể dùng nhiều topping
  toppings ProductTopping[]

  // Một sản phẩm có thể có nhiều size / biến thể
  variants ProductVariant[]

  // Các món trong giỏ hàng đang tham chiếu tới sản phẩm này
  cartItems CartItem[]

  // Các OrderItem từng mua sản phẩm này
  orderItems OrderItem[]

  // Các lượt đánh giá sản phẩm từ những đơn đã hoàn tất
  productReviews ProductReview[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
}

// Biến thể sản phẩm theo size
model ProductVariant {
  id Int @id @default(autoincrement())

  // Ví dụ: S, M, L
  size String

  // Giá riêng của từng size
  price Decimal @db.Decimal(10, 2)

  // Trạng thái variant: true = hoạt động, false = bị khóa
  isActive Boolean @default(true)

  // Mỗi variant thuộc về một sản phẩm
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Các CartItem đang sử dụng size này
  cartItems CartItem[]

  // Các OrderItem từng sử dụng variant này
  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Một sản phẩm không được có 2 variant cùng size
  @@unique([productId, size])
  // Tăng tốc truy vấn theo productId
  @@index([productId])
}

// Topping có thể thêm vào sản phẩm
model Topping {
  id       Int     @id @default(autoincrement())
  name     String  @unique
  price    Decimal @db.Decimal(10, 2)
  isActive Boolean @default(true)

  // Một topping có thể áp dụng cho nhiều sản phẩm
  products ProductTopping[]

  // Các CartItem đang chọn topping này
  cartItems CartItemTopping[]

  // Các topping đã được lưu trong lịch sử đơn hàng
  orderItems OrderItemTopping[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Bảng trung gian cho quan hệ nhiều-nhiều Product và Topping
model ProductTopping {
  productId Int
  toppingId Int

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  topping Topping @relation(fields: [toppingId], references: [id], onDelete: Cascade)

  // Một cặp Product + Topping chỉ được tồn tại một lần
  @@id([productId, toppingId])
  @@index([toppingId])
}

// Giỏ hàng của người dùng
model Cart {
  id Int @id @default(autoincrement())

  // Mỗi user chỉ có một giỏ hàng
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Các món hiện có trong giỏ hàng
  items CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Một món đã được thêm vào giỏ hàng
model CartItem {
  id Int @id @default(autoincrement())

  // CartItem thuộc về một giỏ hàng
  cartId Int
  cart   Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  // Sản phẩm được chọn
  productId Int
  product   Product @relation(fields: [productId], references: [id])

  // Size / variant được chọn
  variantId Int
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  // Số lượng sản phẩm
  quantity Int @default(1)

  // Các topping được chọn cho CartItem này
  toppings CartItemTopping[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cartId])
  @@index([productId])
  @@index([variantId])
}

// Bảng trung gian lưu topping được chọn cho từng CartItem
model CartItemTopping {
  cartItemId Int
  toppingId  Int

  cartItem CartItem @relation(fields: [cartItemId], references: [id], onDelete: Cascade)
  topping  Topping  @relation(fields: [toppingId], references: [id])

  // Một topping chỉ được chọn một lần trong cùng một CartItem
  @@id([cartItemId, toppingId])
  @@index([toppingId])
}

// Trạng thái xử lý đơn hàng
enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  DELIVERING
  COMPLETED
  CANCELLED
}

// Cách khách nhận món
enum FulfillmentMethod {
  DELIVERY
  PICKUP
}

// Đơn hàng của người dùng
model Order {
  id Int @id @default(autoincrement())

  // User đã đặt đơn
  userId Int
  user   User @relation(fields: [userId], references: [id])

  // Tổng tiền trước khi áp dụng voucher
  subtotal Decimal @default(0) @db.Decimal(10, 2)

  // Số tiền được giảm
  discountAmount Decimal @default(0) @db.Decimal(10, 2)

  // Tổng tiền cuối cùng khách phải thanh toán
  totalPrice Decimal @db.Decimal(10, 2)

  // Thông tin nhận hàng được lưu snapshot theo từng đơn
  fulfillmentMethod FulfillmentMethod @default(DELIVERY)
  receiverName      String
  receiverPhone     String
  deliveryAddress   String
  note              String?

  // Snapshot giao hàng do backend tính lại lúc checkout
  deliveryLatitude       Decimal? @db.Decimal(10, 7)
  deliveryLongitude      Decimal? @db.Decimal(10, 7)
  deliveryDistanceKm     Decimal  @default(0) @db.Decimal(10, 2)
  deliveryBaseFee        Decimal  @default(0) @db.Decimal(10, 2)
  deliveryDiscountAmount Decimal  @default(0) @db.Decimal(10, 2)
  deliveryFee            Decimal  @default(0) @db.Decimal(10, 2)

  status OrderStatus @default(PENDING)

  // Dấu vết hủy đơn để khách hàng và cửa hàng cùng tra cứu được nguyên nhân.
  cancelReason String?
  cancelledAt  DateTime?

  items           OrderItem[]
  appliedVouchers OrderVoucher[]
  notifications   Notification[]

  // Voucher đã áp dụng cho đơn hàng
  voucherId Int?
  voucher   Voucher? @relation(fields: [voucherId], references: [id])

  // Snapshot mã voucher tại thời điểm checkout
  voucherCode String?

  // Thông tin thanh toán của đơn hàng
  payment Payment?

  // Mỗi đơn hàng chỉ được đánh giá một lần
  review OrderReview?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Số điểm khách đã dùng cho đơn hàng
  loyaltyPointsUsed Int @default(0)

  // Số tiền được giảm từ điểm
  loyaltyDiscountAmount Decimal @default(0) @db.Decimal(10, 2)

  // Số điểm đã cộng sau khi đơn hoàn tất
  loyaltyPointsEarned Int @default(0)

  // Dùng để chống cộng điểm nhiều lần
  loyaltyPointsGrantedAt DateTime?

  @@index([userId])
  @@index([status])
  @@index([voucherId])
}

// Thông báo của user; orderId có thể null cho thông báo hệ thống sau này.
model Notification {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  orderId Int?
  order   Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  type    String
  title   String
  message String
  isRead  Boolean @default(false)
  readAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([orderId])
}

// Một sản phẩm trong đơn hàng
model OrderItem {
  id Int @id @default(autoincrement())

  orderId Int
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Giữ relation để tra cứu sản phẩm gốc
  productId Int
  product   Product @relation(fields: [productId], references: [id])

  variantId Int
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  // Snapshot thông tin tại thời điểm đặt hàng
  productName String
  size        String

  // Giá variant tại thời điểm checkout
  variantPrice Decimal @db.Decimal(10, 2)

  quantity Int

  // Giá 1 món = variant + toàn bộ topping
  unitPrice Decimal @db.Decimal(10, 2)

  // Tổng tiền của dòng = unitPrice × quantity
  lineTotal Decimal @db.Decimal(10, 2)

  toppings OrderItemTopping[]

  createdAt DateTime @default(now())

  // Mỗi dòng món trong đơn chỉ có tối đa một đánh giá
  productReview ProductReview?

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

// Snapshot topping trong từng OrderItem
model OrderItemTopping {
  id Int @id @default(autoincrement())

  orderItemId Int
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  // Giữ toppingId để truy vết dữ liệu gốc
  toppingId Int
  topping   Topping @relation(fields: [toppingId], references: [id])

  // Snapshot tên và giá topping tại thời điểm đặt
  toppingName  String
  toppingPrice Decimal @db.Decimal(10, 2)

  @@index([orderItemId])
  @@index([toppingId])
}

// Đánh giá tổng thể của một đơn hàng đã hoàn tất
model OrderReview {
  id Int @id @default(autoincrement())

  // Người tạo đánh giá
  userId Int
  user   User @relation("ReviewAuthor", fields: [userId], references: [id], onDelete: Cascade)

  // Một đơn chỉ có tối đa một đánh giá
  orderId Int   @unique
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Điểm tổng thể từ 1 đến 5
  overallRating Int

  // Nhận xét chung về đơn hàng
  comment String?

  // Admin có thể ẩn đánh giá vi phạm
  isVisible Boolean @default(true)

  // Phản hồi chính thức của cửa hàng
  adminReply String?

  // Admin đã phản hồi
  adminRepliedById Int?
  adminRepliedBy   User? @relation("ReviewResponder", fields: [adminRepliedById], references: [id], onDelete: SetNull)

  // Thời điểm phản hồi gần nhất
  adminRepliedAt DateTime?

  // Đánh giá riêng từng món
  productReviews ProductReview[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([isVisible])
  @@index([createdAt])
  @@index([adminRepliedById])
}

// Đánh giá một món cụ thể trong đơn hàng
model ProductReview {
  id Int @id @default(autoincrement())

  orderReviewId Int
  orderReview   OrderReview @relation(fields: [orderReviewId], references: [id], onDelete: Cascade)

  // Một OrderItem chỉ được đánh giá một lần
  orderItemId Int       @unique
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  // Backend tự lấy productId từ OrderItem
  productId Int
  product   Product @relation(fields: [productId], references: [id])

  // Điểm món từ 1 đến 5
  rating Int

  // Nhận xét riêng về món
  comment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderReviewId])
  @@index([productId])
  @@index([rating])
}

// Kiểu giảm giá của voucher
enum DiscountType {
  PERCENT
  FIXED
}

// Mã giảm giá
model Voucher {
  id Int @id @default(autoincrement())

  // Mã khách nhập, ví dụ: SALE20
  code String @unique

  description String?

  // Kiểu giảm giá: phần trăm hoặc số tiền cố định
  discountType DiscountType

  // Giá trị giảm: 20 nghĩa là 20% hoặc 20.000 tùy discountType
  discountValue Decimal @db.Decimal(10, 2)

  // Giá trị đơn hàng tối thiểu để được áp dụng voucher
  minOrderValue Decimal? @db.Decimal(10, 2)

  // Số tiền giảm tối đa, thường dùng cho voucher phần trăm
  maxDiscount Decimal? @db.Decimal(10, 2)

  // Giới hạn tổng số lần voucher được sử dụng
  usageLimit Int?

  // Số lượt đã sử dụng
  usedCount Int @default(0)

  // Thời gian hiệu lực
  startAt DateTime
  endAt   DateTime

  // ADMIN có thể bật/tắt voucher
  isActive Boolean @default(true)

  // Các đơn hàng đã áp dụng voucher
  orders        Order[]
  orderVouchers OrderVoucher[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Các voucher thực tế đã áp dụng cho một đơn hàng
model OrderVoucher {
  orderId   Int
  voucherId Int

  // Snapshot để lịch sử không đổi khi voucher được chỉnh sửa
  code           String
  discountAmount Decimal  @default(0) @db.Decimal(10, 2)
  createdAt      DateTime @default(now())

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  voucher Voucher @relation(fields: [voucherId], references: [id])

  @@id([orderId, voucherId])
  @@index([voucherId])
}

// Phương thức thanh toán
enum PaymentMethod {
  COD
  BANK_TRANSFER
}

// Trạng thái thanh toán
enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

// Thông tin thanh toán của đơn hàng
model Payment {
  id Int @id @default(autoincrement())

  // Mỗi Order chỉ có tối đa một Payment
  orderId Int   @unique
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  method PaymentMethod

  status PaymentStatus @default(PENDING)

  // Snapshot số tiền cần thanh toán
  amount Decimal @db.Decimal(10, 2)

  // Mã giao dịch từ ngân hàng/cổng thanh toán nếu có
  transactionCode String?

  // Thời điểm thanh toán thành công
  paidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([method])
}

// Địa chỉ giao hàng được user lưu để tái sử dụng ở checkout.
model UserAddress {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Ví dụ: Nhà riêng, Công ty, Nhà người thân.
  label String @db.VarChar(30)

  receiverName  String @db.VarChar(100)
  receiverPhone String @db.VarChar(20)

  // Địa chỉ đầy đủ sau khi khách chọn từ gợi ý hoặc bản đồ.
  addressLine String @db.VarChar(500)

  // Lưu tọa độ để checkout không phải tìm lại vị trí.
  latitude  Decimal @db.Decimal(10, 7)
  longitude Decimal @db.Decimal(10, 7)

  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, isDefault])
}